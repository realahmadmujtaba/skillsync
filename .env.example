# Copy to .env for local development.
# Leave empty (or unset) to run the frontend in offline/local-only mode.
# Also read by docker-compose.yml as a build arg for the `web` service.
VITE_API_URL=http://localhost:8001

# Google Cloud Console OAuth 2.0 Client ID (Web application). Leave empty to
# hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
