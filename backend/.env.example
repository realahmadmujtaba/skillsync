# Copy to .env for local development, or set these as env vars on Railway.
#
# Production DB is Supabase Postgres (project "skillsync", ref rargrnjrwforebjwnlkq).
# Get the real password from Supabase Dashboard -> Project Settings -> Database
# -> Connection string -> "Session pooler" (works for a long-lived Railway
# service; avoids IPv6-only direct-connection issues). Note the driver is
# psycopg 3, so the scheme must be postgresql+psycopg:// (Supabase's own copy
# button gives you postgresql://, just swap the scheme).
DATABASE_URL=postgresql+psycopg://postgres.rargrnjrwforebjwnlkq:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# For local Docker Postgres instead of Supabase, use:
# DATABASE_URL=postgresql+psycopg://skillsync:skillsync@localhost:5432/skillsync

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (add your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
