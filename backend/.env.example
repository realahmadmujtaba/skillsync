# Copy to .env for local development, or set these as env vars on your host.
#
# Production DB is Azure Database for PostgreSQL Flexible Server (free tier,
# server "skillsync-db", region Central India). Note the driver is psycopg 3,
# so the scheme must be postgresql+psycopg://, and Azure requires TLS.
DATABASE_URL=postgresql+psycopg://skillsyncadmin:[YOUR-DB-PASSWORD]@skillsync-db.postgres.database.azure.com:5432/postgres?sslmode=require

# For local Docker Postgres instead of Azure, use:
# DATABASE_URL=postgresql+psycopg://skillsync:skillsync@localhost:5432/skillsync

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (add your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# console.groq.com API key (free tier, no card required) — powers AI resume analysis.
GROQ_API_KEY=gsk_...

# Google Cloud Console OAuth 2.0 Client ID (Web application) — powers "Continue with Google".
GOOGLE_CLIENT_ID=
