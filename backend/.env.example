# Copy to .env for local development, or set these as env vars on your host.
#
# Production DB is Azure Database for PostgreSQL Flexible Server (free tier,
# server "skillsync-db", region Central India). Note the driver is psycopg 3,
# so the scheme must be postgresql+psycopg://, and Azure requires TLS.
DATABASE_URL=postgresql+psycopg://skillsyncadmin:[YOUR-DB-PASSWORD]@skillsync-db.postgres.database.azure.com:5432/postgres?sslmode=require

# For local Docker Postgres instead of Azure, use:
# DATABASE_URL=postgresql+psycopg://skillsync:skillsync@localhost:5432/skillsync

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (add your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# console.groq.com API key (free tier, no card required) — powers AI resume analysis.
GROQ_API_KEY=gsk_...

# Google Cloud Console OAuth 2.0 Client ID (Web application) — powers "Continue with Google".
GOOGLE_CLIENT_ID=

# developer.adzuna.com free API credentials — powers real job listings in Opportunities.
# Leave empty to fall back to the small seeded demo list.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated Adzuna country codes to search across (each is queried in
# parallel and results merged) — see https://developer.adzuna.com/overview
# for the full supported list.
ADZUNA_COUNTRIES=us,gb,in,ca,au,de

# Gmail SMTP — powers "Forgot password" emails. Leave SMTP_USER/SMTP_PASSWORD
# empty to disable the feature (forgot-password still succeeds, just skips
# sending). SMTP_PASSWORD must be a Gmail "App Password" (myaccount.google.com
# -> Security -> 2-Step Verification -> App passwords), NOT your normal
# Gmail password. Requires 2-Step Verification enabled on the account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=SkillSync <your-address@gmail.com>

# Public frontend URL, used to build the password-reset link sent by email.
FRONTEND_URL=http://localhost:8443
